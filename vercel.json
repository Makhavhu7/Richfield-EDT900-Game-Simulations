{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.mjs": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "**",
      "excludeFiles": "node_modules/**"
    }
  },
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/api/assets/:path*"
    },
    {
      "source": "/index",
      "destination": "/api/pages/index"
    },
    {
      "source": "/game",
      "destination": "/api/pages/game"
    },
    {
      "source": "/login",
      "destination": "/api/pages/login"
    },
    {
      "source": "/register",
      "destination": "/api/pages/register"
    },
    {
      "source": "/admin",
      "destination": "/api/pages/admin"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
